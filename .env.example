ANTHROPIC_API_KEY=sk-ant-...

# Bitcoin Core regtest RPC
BITCOIN_RPC_HOST=127.0.0.1
BITCOIN_RPC_PORT=18443
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASS=bitcoin

# Fulcrum Electrum server (TCP, no TLS for regtest)
FULCRUM_HOST=127.0.0.1
FULCRUM_PORT=50001

# Path to the electrum binary (defaults to sibling ../electrum/run_electrum)
ELECTRUM_BIN=../electrum/run_electrum

# Set to 1 to keep Xvfb display alive after each scenario (for debugging)
DWF_DEBUG_DISPLAY=0
